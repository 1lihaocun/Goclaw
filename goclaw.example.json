{
  "database": {
    "path": "var/goclaw.db"
  },
  "workspace": {
    "root": "var/workspace"
  },
  "channels": {
    "feishu": {
      "enabled": true,
      "defaultAccount": "main",
      "connectionMode": "longpoll",
      "renderMode": "auto",
      "actions": {
        "processingAck": true,
        "messageSend": true,
        "messageUpdate": true,
        "messageRecall": true,
        "reactions": true,
        "pins": true,
        "postMessages": true,
        "docsRead": true
      },
      "processingAckEmoji": "EYES",
      "accounts": {
        "main": {
          "profileId": "main",
          "renderMode": "auto",
          "processingAckEmoji": "DONE",
          "actions": {
            "processingAck": false
          }
        }
      }
    }
  },
  "model": {
    "provider": "openai-compatible",
    "api": "openai-completions",
    "baseUrl": "https://api.openai.com/v1",
    "modelId": "gpt-4.1-mini"
  },
  "tooling": {
    "legacyJsonFallbackEnabled": false,
    "maxIterations": 6
  },
  "mcp": {
    "enabled": true,
    "servers": {
      "github": {
        "command": "github-mcp-server",
        "args": [
          "stdio"
        ],
        "safetyClass": "read_only",
        "toolPrefix": "github",
        "handshakeTimeoutSec": 10,
        "callTimeoutSec": 20
      }
    }
  },
  "skills": {
    "enabled": true,
    "root": "var/workspace/skills",
    "maxEntries": 32,
    "maxInline": 4,
    "maxBytesPerSkill": 4000,
    "maxPromptBytes": 16000
  }
}
